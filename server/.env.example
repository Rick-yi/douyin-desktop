# 生产配置模板
# 复制为 server/.env.prod（不要覆盖本地开发 .env），逐项替换 CHANGE_ME。
# 启动前先跑：./tools/prod-preflight.sh .env.prod

SPRING_PROFILES_ACTIVE=prod
PORT=8089
# 只监听回环，由宿主机 Nginx/Caddy 反代；不要直接暴露公网
SERVER_ADDRESS=127.0.0.1

# ---- 必填密钥：openssl rand -base64 32 ----
ADMIN_TOKEN=CHANGE_ME_32_BYTES_BASE64
KEY_HMAC_SECRET=CHANGE_ME_32_BYTES_BASE64
DATA_ENC_KEY=CHANGE_ME_32_BYTES_BASE64

# ---- 对外 HTTPS 地址（必须带域名，不能 localhost）----
PUBLIC_BASE_URL=https://license.example.com

# ---- MySQL 8：同一实例里的独立库 ----
DB_URL='jdbc:mysql://127.0.0.1:3306/zmtjl_license?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&rewriteBatchedStatements=true'
DB_USER=zmtjl
DB_PASSWORD=CHANGE_ME
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_POOL=20
DB_MIN_IDLE=5

# ---- 反向代理 ----
# 前面是 Nginx/Caddy 时开启，否则限流会把所有人算成同一个 IP
TRUST_FORWARDED_FOR=true
TRUSTED_PROXIES=127.0.0.1,::1

# ---- 持久化目录（迁移/重装时不能丢）----
KEYS_DIR=/opt/zmtjl/server/data/keys
RELEASES_DIR=/opt/zmtjl/server/data/releases

# ---- 备份 ----
BACKUP_DIR=/var/backups/zmtjl-license
BACKUP_KEEP_DAYS=30

# ---- 手动开卡阶段 ----
PAY_CHANNELS=manual
ORDER_EXPIRE_MINUTES=30

# ---- 更新清单 ----
# 推荐用管理后台「版本发布」上传；如果不用后台，再启用下面几项
UPDATE_ENABLED=false
# UPDATE_LATEST_VERSION=0.2.0
# UPDATE_MIN_VERSION=0.1.0
# UPDATE_DOWNLOAD_URL=https://license.example.com/v1/app/download/xxx
# UPDATE_SHA256=64位十六进制
# UPDATE_NOTES=本次更新内容
